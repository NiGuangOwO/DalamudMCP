<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.0.0.51</Version>
    <!--
      Plugin manifest. DalamudPackager (pulled in by the SDK) reads these properties and
      writes DalamudMCP.json next to the assembly on every build:
        Debug   -> manifest only
        Release -> manifest + bin\x64\Release\DalamudMCP\latest.zip (the plugin repository package)
      See https://github.com/goatcorp/DalamudPackager
    -->
    <Author>NiGuangOwO</Author>
    <Name>DalamudMCP</Name>
    <Punchline>连接 AI 助手，辅助插件开发与调试 | AI-assisted plugin development &amp; debugging.</Punchline>
    <Description>通过 MCP（模型上下文协议）连接 AI 助手与 FINAL FANTASY XIV，为 Dalamud 插件开发、运行时分析和游戏内验证提供工具。&#10;&#10;读取角色、物品栏、游戏数据、界面文本与运行日志，检查插件和 IPC，并在授权后执行界面交互等操作。&#10;&#10;安装后输入 /dalamudmcp 打开设置，并配置支持 MCP 的 AI 客户端。默认仅开放只读工具；修改游戏状态的工具需手动启用。仅支持 stdio 的客户端可使用配套桥接程序。&#10;&#10;Connect AI agents to FINAL FANTASY XIV through the Model Context Protocol (MCP) for Dalamud plugin development, runtime analysis, and in-game validation.&#10;&#10;Read character, inventory, game data, UI text, and runtime logs; inspect plugins and IPC; and perform UI interactions with explicit permission.&#10;&#10;After installation, open settings with /dalamudmcp and configure an MCP-compatible AI client. Only read-only tools are enabled by default; tools that change game state must be enabled manually. A companion bridge is available for stdio-only clients.</Description>
    <RepoUrl>https://github.com/NiGuangOwO/DalamudMCP</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/NiGuangOwO/DalamudMCP/main/src/DalamudMCP/images/icon.png</IconUrl>
    <Tags>mcp;ai;agent;development;debugging;memory;api;开发;调试</Tags>
    <ApplicableVersion>any</ApplicableVersion>
    <DalamudApiLevel>15</DalamudApiLevel>
    <AcceptsFeedback>false</AcceptsFeedback>
    <!-- InternalName and AssemblyVersion are filled in by the packager from the assembly. -->
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>DalamudMCP</AssemblyName>
    <RootNamespace>DalamudMCP</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS1591</NoWarn>
    <!-- Keep the historical output layout; tests and the READMEs point at it. -->
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local dev-plugin icon; Packager also publishes images beside latest.zip. -->
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Settings branding does not depend on an HTTP request or an external file. -->
    <EmbeddedResource Include="images\icon.png" LogicalName="DalamudMCP.icon.png" />
    <EmbeddedResource Include="Network\Data\opcodes.min.json" LogicalName="DalamudMCP.opcodes.min.json" />
    <EmbeddedResource Include="Network\Data\FFXIVOpcodes.LICENSE" LogicalName="DalamudMCP.FFXIVOpcodes.LICENSE" />
    <EmbeddedResource Include="Network\Data\elpis-schemas.json" LogicalName="DalamudMCP.elpis-schemas.json" />
    <EmbeddedResource Include="Network\Data\elpis.LICENSE" LogicalName="DalamudMCP.elpis.LICENSE" />
    <EmbeddedResource Include="Network\Data\elpis-FFXIVClientStructs.LICENSE" LogicalName="DalamudMCP.elpis-FFXIVClientStructs.LICENSE" />
    <EmbeddedResource Include="Network\Data\elpis-opcode-worker.LICENSE" LogicalName="DalamudMCP.elpis-opcode-worker.LICENSE" />
    <Content Include="Network\Data\elpis*.LICENSE" CopyToOutputDirectory="PreserveNewest" TargetPath="licenses\%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="../../build/AgentGuidanceResources.props" />
</Project>
