<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <SdkPath>$(AppData)/XIVLauncherCN/addon/Hooks/dev</SdkPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/DalamudMCP/Logging/*.cs" Link="Logging/%(Filename)%(Extension)" />
    <Compile Include="../../src/DalamudMCP/Mcp/Json.cs" Link="Mcp/Json.cs" />
    <Compile Include="../../src/DalamudMCP/Mcp/ToolRegistry.cs" Link="Mcp/ToolRegistry.cs" />
    <Reference Include="Dalamud"><HintPath>$(SdkPath)/Dalamud.dll</HintPath></Reference>
    <Reference Include="Serilog"><HintPath>$(SdkPath)/Serilog.dll</HintPath></Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
