    <DalamudHome Condition="'$(DalamudHome)' == '' and Exists('$(AppData)/XIVLauncherCN/addon/Hooks/dev/FFXIVClientStructs.dll')">$(AppData)/XIVLauncherCN/addon/Hooks/dev</DalamudHome>
    <DalamudHome Condition="'$(DalamudHome)' == ''">$(AppData)/XIVLauncher/addon/Hooks/dev</DalamudHome>
