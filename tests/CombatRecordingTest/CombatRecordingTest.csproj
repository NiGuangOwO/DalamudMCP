    <Compile Include="../../src/DalamudMCP/Mcp/Json.cs" Link="Json.cs" />
    <Compile Include="../../src/DalamudMCP/Mcp/ToolRegistry.cs" Link="ToolRegistry.cs" />
    <Compile Include="../../src/DalamudMCP/MemoryProbe.cs" Link="MemoryProbe.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="FFXIVClientStructs"><HintPath>$(DalamudHome)/FFXIVClientStructs.dll</HintPath></Reference>
    <Reference Include="InteropGenerator.Runtime"><HintPath>$(DalamudHome)/InteropGenerator.Runtime.dll</HintPath></Reference>
  </ItemGroup>
</Project>
